# Copy OUTSIDE the repository to /etc/invoiceguard/runtime.env; chmod 600.
# Raw env_file syntax: unquoted KEY=value, no shell expansion or inline comments.
# Do not source this file. APP_IMAGE must identify a built commit, not latest.
APP_IMAGE=invoiceguard-ai:REPLACE_WITH_COMMIT
APP_DOMAIN=invoiceguard.example.com
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
S3_BUCKET=invoiceguard-ai-demo-2026-unique123
AWS_DEFAULT_REGION=REPLACE_WITH_EXISTING_BUCKET_REGION
S3_PREFIX=invoiceguard/
# Existing restricted S3 identity; on EC2 prefer a least-privilege instance role.
# Leave these blank with an instance role. Never paste account administrator keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Preserve the EXISTING key when moving encrypted Gmail connections.
GMAIL_ENCRYPTION_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_TRUSTED_ORIGIN=
ENABLE_EMAIL_INTAKE=false
GMAIL_POLL_SECONDS=60
GMAIL_USE_GEMINI=false
